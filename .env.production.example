# Copy to .env.production on the VPS and fill in real secrets. NEVER commit the real file.

# --- Postgres (used by the postgres container) ---
POSTGRES_USER=dsrj
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=dsrj_canteen

# --- API ---
NODE_ENV=production
# host = the compose service name "postgres"
DATABASE_URL=postgresql://dsrj:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/dsrj_canteen
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=12h
PORT=4000
# Same-origin in production, but set to your VPS URL for clarity/hardening.
CORS_ORIGIN=http://YOUR_VPS_IP
